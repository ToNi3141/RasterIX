PROJ = Rasterizer

VERILATOR = verilator

IF_FRAMEBUFFER_SIZE_IN_PIXEL_LG_INT = 15
ENABLE_TEXTURE_CACHE ?= 1

all: rixif

clean:
	rm -rf obj_dir

rixif:
	$(VERILATOR) -Wno-SELRANGE -Wno-lint -DUNITTEST -DVARIANT=if -DIF_FRAMEBUFFER_SIZE_IN_PIXEL_LG=$(IF_FRAMEBUFFER_SIZE_IN_PIXEL_LG_INT) -GENABLE_TEXTURE_CACHE=$(ENABLE_TEXTURE_CACHE) -CFLAGS '-arch x86_64 -O3' --cc top.v --top-module top -I../../RasterIX -I../../3rdParty -I../../Float/rtl/float/ -I../../3rdParty/verilog-axi -I../../3rdParty/verilog-axis -I../../Display
	-make -C obj_dir -f Vtop.mk

rixef:
	$(VERILATOR) -Wno-SELRANGE -Wno-lint -DUNITTEST -DVARIANT=ef -DIF_FRAMEBUFFER_SIZE_IN_PIXEL_LG=$(IF_FRAMEBUFFER_SIZE_IN_PIXEL_LG_INT) -GENABLE_TEXTURE_CACHE=$(ENABLE_TEXTURE_CACHE) -CFLAGS '-arch x86_64 -O3' --cc top.v --top-module top -I../../RasterIX -I../../3rdParty -I../../Float/rtl/float/ -I../../3rdParty/verilog-axi -I../../3rdParty/verilog-axis -I../../Display
	-make -C obj_dir -f Vtop.mk

rixif-trace:
	$(VERILATOR) -Wno-SELRANGE --trace -Wno-lint -DUNITTEST -DVARIANT=if -DIF_FRAMEBUFFER_SIZE_IN_PIXEL_LG=$(IF_FRAMEBUFFER_SIZE_IN_PIXEL_LG_INT) -GENABLE_TEXTURE_CACHE=$(ENABLE_TEXTURE_CACHE) -CFLAGS '-arch x86_64 -O3' --cc top.v --top-module top -I../../RasterIX -I../../3rdParty -I../../Float/rtl/float/ -I../../3rdParty/verilog-axi -I../../3rdParty/verilog-axis -I../../Display
	-make -C obj_dir -f Vtop.mk

rixef-trace:
	$(VERILATOR) -Wno-SELRANGE --trace -Wno-lint -DUNITTEST -DVARIANT=ef -DIF_FRAMEBUFFER_SIZE_IN_PIXEL_LG=$(IF_FRAMEBUFFER_SIZE_IN_PIXEL_LG_INT) -GENABLE_TEXTURE_CACHE=$(ENABLE_TEXTURE_CACHE) -CFLAGS '-arch x86_64 -O3' --cc top.v --top-module top -I../../RasterIX -I../../3rdParty -I../../Float/rtl/float/ -I../../3rdParty/verilog-axi -I../../3rdParty/verilog-axis -I../../Display
	-make -C obj_dir -f Vtop.mk

.SECONDARY:
.PHONY: all clean
